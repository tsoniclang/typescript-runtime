{
  "name": "@tsonic/typescript-runtime",
  "version": "0.0.1",
  "description": "Ordinary TypeScript runtime artifacts for the Tsonic TypeScript target",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./location.js": {
      "types": "./dist/location.d.ts",
      "default": "./dist/location.js"
    },
    "./raw-pointer.js": {
      "types": "./dist/raw-pointer.d.ts",
      "default": "./dist/raw-pointer.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT"
}
